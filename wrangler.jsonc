{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datacruise-arcade",
  "compatibility_date": "2026-05-14",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GUMROAD_PRODUCT_ID": "wxahk"
  }
}
